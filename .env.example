# Documentation template only. The server does not auto-load dotenv files.
# Copy to .env, keep it private, replace the placeholders, and start with:
# node --env-file=.env dist/serve.js
# Alternatively provide these variables through the shell/deployment environment.

# Bind address and port. Non-loopback binds require an API or admin token.
DEEPLOOK_HOST=127.0.0.1
DEEPLOOK_PORT=47231

# Absolute path to the built browser CLI in your recursive source clone.
DEEPLOOK_CLI_PATH=/absolute/path/to/DeepLook-API/vendor/deeplook/dist/cli.js

# Generate locally: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# This placeholder is deliberately invalid (less than 32 characters).
# Admin/API tokens must be distinct, 32-512 characters, with no whitespace.
DEEPLOOK_ADMIN_TOKEN=<generate-locally>

# Optional legacy token for POST /v1/open; it has no per-account accounting.
# Leave unset for managed, named browser keys. Never reuse the admin token.
# DEEPLOOK_API_TOKEN=<generate-separately>

# Account state location, relative to the working directory or absolute.
DEEPLOOK_DATA_DIR=./data

# Process-wide browser limit, 1-100. Default: 2.
DEEPLOOK_MAX_CONCURRENT=2

# Optional explicit Chrome/Chromium executable; otherwise use browser discovery.
# DEEPLOOK_CHROME=/usr/bin/chromium

# No SMTP variables are consumed by DeepLook API. Email is caller-owned.
