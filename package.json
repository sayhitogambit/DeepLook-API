{
  "name": "deeplook-api",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted HTTP API for the open-source DeepLook browser CLI.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js",
    "test:browser": "npm --prefix vendor/deeplook run build && tsc && DEEPLOOK_TEST_BROWSER=1 node --test dist/engine-browser.integration.test.js",
    "test:container": "node scripts/test-container.mjs",
    "api": "node dist/serve.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "author": "DeepLook contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayhitogambit/DeepLook-API.git"
  },
  "homepage": "https://github.com/sayhitogambit/DeepLook-API#readme",
  "bugs": {
    "url": "https://github.com/sayhitogambit/DeepLook-API/issues"
  }
}
